]

%% Alle Optionen an xcolor weiterreichen, z.B. \usepackage[dvipsnames]{bokucolors}
\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{xcolor}}
\ProcessOptions\relax

\RequirePackage{xcolor}

\definecolor{bokugreen}{RGB}{0, 170, 90}%
%\definecolor{bokugreenm}{RGB}{154, 221, 188}%
\colorlet{bokugreenm}{bokugreen!60}
%\definecolor{bokugreenl}{RGB}{205, 235, 222}%
\colorlet{bokugreenl}{bokugreen!30}

\definecolor{bokuorange}{RGB}{230, 100, 30}%
%\definecolor{bokuorangem}{RGB}{244, 193, 165}%
\colorlet{bokuorangem}{bokuorange!60}
%\definecolor{bokuorangel}{RGB}{248, 223, 211}%
\colorlet{bokuorangel}{bokuorange!30}

\definecolor{bokupurple}{RGB}{75,40,140}%
%\definecolor{bokupurplem}{RGB}{184, 169, 210}%
\colorlet{bokupurplem}{bokupurple!60}
%\definecolor{bokupurplel}{RGB}{219, 211, 232}%
\colorlet{bokupurplel}{bokupurple!30}

\definecolor{bokublue}{RGB}{0,110,171}
\definecolor{bokulila}{RGB}{145,65,150}

\definecolor{bokublack}{cmyk}{0,0,0,1}%
\definecolor{bokugray}{cmyk}{0,0,0,0.9}%
\definecolor{bokugraym}{cmyk}{0,0,0,0.6}%
\definecolor{bokugrayl}{cmyk}{0,0,0,0.2}%
\definecolor{bokugray80}{cmyk}{0,0,0,0.8}%
