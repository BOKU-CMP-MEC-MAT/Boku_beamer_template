%% Setting the header image based on input 'ID'.
%% Switch/Case, Default is "1" or boku_header.png.
\newcommand{\headerimage}[1]{%
   \IfStrEqCase{#1}{%
      {4}{%
         \gdef\myheaderimageid{#1}%
         \gdef\myheaderimageposition{ne}%
         \gdef\myheaderimage{boku_header4.png}%
      }{3}{%
         \gdef\myheaderimageid{#1}%
         \gdef\myheaderimageposition{ne}%
         \gdef\myheaderimage{boku_header3.png}%
      }{2}{%
         \gdef\myheaderimageid{#1}%
         \gdef\myheaderimageposition{nw}%
         \gdef\myheaderimage{boku_header2.png}%
      }}[%
         \gdef\myheaderimageid{1}%
         \gdef\myheaderimageposition{nw}%
         \gdef\myheaderimage{boku_header.png}%
         %\gdef\myheaderimage{boku_header_lower.png}%
      ]%
}


